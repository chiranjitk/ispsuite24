--
-- Name: time_to_sec(text); Type: FUNCTION; Schema: public; Owner: cryptsk
--

CREATE FUNCTION public.time_to_sec(t text) RETURNS bigint
    LANGUAGE plpgsql
    AS $$
 DECLARE

     hs bigint;
     ms bigint;
     s bigint;
     col1 text;
     col2 text;
     col3 text;
     colint1 bigint;
     colint2 bigint;
     colint3 bigint;
 BEGIN
     SELECT split_part(t, ':', 1) INTO col1;
     SELECT split_part(t, ':', 2) INTO col2;
     SELECT split_part(t, ':', 3) INTO col3;
     SELECT col1::bigint INTO colint1;
     SELECT col2::bigint INTO colint2;
     SELECT col3::bigint INTO colint3;
     SELECT (colint1 * 60*60) INTO hs;
     SELECT (colint2 * 60) INTO ms;
     SELECT (colint1) INTO s;
     SELECT (hs + ms + s) INTO s;
     RETURN s;
 END;
$$;


