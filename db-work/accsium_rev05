--
-- Name: fn_get_tax_amount(integer, text, double precision); Type: FUNCTION; Schema: public; Owner: cryptsk
--

CREATE FUNCTION public.fn_get_tax_amount(grpid integer, proportiontype text, pkgprice double precision) RETURNS double precision
    LANGUAGE plpgsql
    AS $$
    DECLARE
        n_internetserviceid integer;
        d_taxvalue double precision;
        d_proportion double precision;
        d_taxamount double precision;

    BEGIN

        SELECT t.taxvalue, t.internetserviceid INTO d_taxvalue, n_internetserviceid
        FROM tbltaxinforel t
        WHERE t.relationtype = 'G' AND t.taxtype = -11 AND t.relationid = grpid;

        IF NOT FOUND THEN
            n_internetserviceid := 0;
            d_taxvalue := 0.00;
        END IF;

        IF n_internetserviceid = -1 THEN
            d_proportion := 1.0;
        ELSE
            IF proportiontype = 'D' THEN
                SELECT gs.proportion INTO d_proportion FROM tblgatewayservice gs WHERE gs.gatewayserviceid = n_internetserviceid;
            END IF;
            IF proportiontype = 'M' THEN
                SELECT ggs.proportion INTO d_proportion FROM tblgroupgatewayservice ggs WHERE ggs.groupid = grpid AND ggs.gatewayserviceid = n_internetserviceid;
            END IF;
        END IF;

        d_taxamount := (d_taxvalue / 100.0) * (pkgprice * d_proportion);

        RETURN d_taxamount;
    END;
$$;


