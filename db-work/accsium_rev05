        SELECT replace(newformat,'%j','DDD') INTO newformat;
        SELECT replace(newformat,'%H','HH24') INTO newformat;
        SELECT replace(newformat,'%k','FMHH24') INTO newformat;
        SELECT replace(newformat,'%h','HH12') INTO newformat;
