--
-- Name: vw_consolidated_finance_rep; Type: VIEW; Schema: public; Owner: cryptsk
--

CREATE VIEW public.vw_consolidated_finance_rep AS
 SELECT DISTINCT inv.invoiceid,
    uad.transactionid,
    inv.accountid,
    inv.invdate,
    dt.expdate,
    dt.fromdate,
    tu.username,
    inv.fullname,
    inv.ispostpaid,
    dt.todate,
    ' '::text AS cycletype,
    0 AS cyclemultiplier,
    ' '::text AS expiredays,
    (((((((((((inv.add1)::text || ', '::text) || (inv.add2)::text) || ', '::text) || (inv.city)::text) || ', '::text) || (inv.state)::text) || ', '::text) || (inv.country)::text) || ', '::text) || (inv.pincode)::text) AS adddetails,
    dt.packagename,
    dt.rate AS totalamt,
    dt.amount,
    zn.zonename,
        CASE
            WHEN (tu.securitylevel = 3) THEN 'HTTP User'::text
            WHEN (tu.securitylevel = 7) THEN 'Leased Line User'::text
            ELSE 'Others'::text
        END AS custtype,
    'NGN'::text AS currcy
   FROM public.tbluseracctdetail uad,
    public.tbluser tu,
    public.tbluseractionhistory hs,
    public.tblinvoice inv,
    public.tblinvdetail dt,
    public.tblzone zn
  WHERE (((uad.accountid)::text = (tu.accountid)::text) AND ((uad.paymentinfo)::text = 'Service Charge'::text) AND ((uad.paymenttype)::text <> 'FD'::text) AND (uad.actiondate >= to_timestamp('2000/01/01 00:00:00'::text, 'YYYY/MM/DD HH24:MI:SS'::text)) AND (uad.actiondate <= to_timestamp('2099/07/30 23:59:59'::text, 'YYYY/MM/DD HH24:MI:SS'::text)) AND (tu.parentid = '-1'::integer) AND (uad.transactionid = hs.transactionid) AND (hs.invoiceid = inv.invoiceid) AND (inv.invoiceid = dt.invoiceid) AND (zn.zoneid = tu.zoneid))
UNION ALL
 SELECT DISTINCT tblinvoice.invoiceid,
    tah.transactionid,
    tblinvoice.accountid,
    tblinvoice.invdate,
    tblinvdetail.expdate,
    tblinvdetail.fromdate,
    tblinvoice.username,
    tblinvoice.fullname,
    tblinvoice.ispostpaid,
    tblinvdetail.todate,
        CASE
            WHEN (tblinvdetail.serviceid <> 3) THEN tblgroup.cycletype
            ELSE ''::bpchar
        END AS cycletype,
        CASE
            WHEN (tblinvdetail.serviceid <> 3) THEN tblgroup.cyclemultiplier
            ELSE 0
        END AS cyclemultiplier,
        CASE
            WHEN (tblinvdetail.serviceid <> 3) THEN (tblpolicy.expiredays)::character varying(10)
            ELSE ''::character varying
        END AS expiredays,
    public.concat_arg5((
        CASE
            WHEN ((tblinvoice.add1 IS NULL) OR (btrim((tblinvoice.add1)::text) = ''::text)) THEN ''::character varying
            ELSE tblinvoice.add1
        END)::text,
        CASE
            WHEN ((tblinvoice.add2 IS NULL) OR (btrim((tblinvoice.add2)::text) = ''::text)) THEN ''::text
            ELSE public.concat_arg2(', '::text, (tblinvoice.add2)::text)
        END,
        CASE
            WHEN ((tblinvoice.city IS NULL) OR (btrim((tblinvoice.city)::text) = ''::text)) THEN ''::text
            ELSE public.concat_arg2(', '::text, (tblinvoice.city)::text)
        END,
        CASE
            WHEN ((tblinvoice.state IS NULL) OR (btrim((tblinvoice.state)::text) = ''::text)) THEN ''::text
            ELSE public.concat_arg3(', '::text, (tblinvoice.state)::text, ','::text)
        END, (
        CASE
            WHEN ((tblinvoice.country IS NULL) OR (btrim((tblinvoice.country)::text) = ''::text)) THEN ''::character varying
            ELSE tblinvoice.country
        END)::text) AS adddetails,
    tblinvdetail.packagename,
    tblinvoice.totalamt,
    foo.amount,
    tblzone.zonename,
        CASE
            WHEN (tbluser.securitylevel = 3) THEN 'HTTP User'::text
            WHEN (tbluser.securitylevel = 7) THEN 'Leased Line User'::text
            ELSE 'Others'::text
        END AS custtype,
    'NGN'::text AS currcy
   FROM public.tbluser,
    public.tblgroup,
    public.tblpolicy,
    public.tbluseractionhistory tah,
    public.tblinvoice,
    public.tblinvdetail,
    public.tblzone,
    ( SELECT max(tblinvdetail_1.invdetailid) AS invdetailid,
            sum(tblinvdetail_1.amount) AS amount
           FROM public.tblinvdetail tblinvdetail_1
          WHERE (((tblinvdetail_1.serviceid = 0) OR (tblinvdetail_1.serviceid = 8)) AND (tblinvdetail_1.invoicetype <> (3)::numeric))
          GROUP BY tblinvdetail_1.invoiceid) foo
  WHERE ((foo.invdetailid = tblinvdetail.invdetailid) AND ((tblinvdetail.serviceid = 0) OR (tblinvdetail.serviceid = 8)) AND (tblinvoice.createdate >= to_timestamp('2000/05/01 00:00:00:000:000'::text, 'YYYY/MM/DD HH24:MI:SS:MS:US'::text)) AND (tblinvoice.createdate <= to_timestamp('2099/07/20 23:59:59:999:999'::text, 'YYYY/MM/DD HH24:MI:SS:MS:US'::text)) AND (tblgroup.policyid = tblpolicy.policyid) AND
        CASE
            WHEN (tblinvdetail.serviceid <> 3) THEN (tblgroup.groupid = tblinvdetail.groupid)
            ELSE (tblgroup.groupid <> tblinvdetail.groupid)
