CREATE FUNCTION public.inet_aton_ip(ipaddress character varying) RETURNS numeric
    LANGUAGE plpgsql
    AS $_$
declare
ipaddress varchar;
ipstatus  varchar;
BEGIN
ipaddress := $1;
ipstatus := ( (SUBSTRING(IPADDRESS from 1 for INSTR(ipaddress,'.')-1)::numeric * 256 * 256 * 256 )
				+
				(SUBSTRING(ipaddress from INSTR(IPADDRESS,'.',1,1)+1 for ((INSTR(ipaddress,'.',1,2)-1)-INSTR(ipaddress,'.',1,1)))::numeric * 256 * 256)
				+
				(SUBSTRING(ipaddress from INSTR(ipaddress,'.',1,2)+1 for ((INSTR(ipaddress,'.',1,3)-1)-INSTR(ipaddress,'.',1,2)))::numeric * 256)
				+
				(SUBSTRING(ipaddress from INSTR(ipaddress,'.',1,3)+1)::numeric));
				return (ipstatus)::numeric;
END;
$_$;


